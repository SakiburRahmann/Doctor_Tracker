# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/doctor-tracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# JWT auth
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars!!
JWT_EXPIRES_IN=1d

# Comma-separated list of frontend origins allowed to call this API (no spaces)
# Local dev:  http://localhost:3000
# Production: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000

# Seed admin account (used by `npm run seed`)
SEED_ADMIN_NAME=Portal Admin
SEED_ADMIN_EMAIL=admin@doctortracker.com
SEED_ADMIN_PASSWORD=Admin@123
