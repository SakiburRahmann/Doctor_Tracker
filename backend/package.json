{
  "name": "doctor-tracker-backend",
  "version": "1.0.0",
  "description": "Doctor Tracker API - secure administrative web application backend (Express + MongoDB)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:indexes": "node src/scripts/syncIndexes.js",
    "seed": "node src/seed.js",
    "seed:destroy": "node src/seed.js --destroy",
    "test": "node scripts/verify-backend.js"
  },
  "keywords": [
